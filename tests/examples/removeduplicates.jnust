extern func print_string(string) void;
extern func print_int(int) void;

package RemoveDupes {
  var nums [20]int;


  func createList() void {
    nums[0] = -11;
    nums[1] = -11;
    nums[2] = -10;
    nums[3] = -10;
    nums[4] = -9;
    nums[5] = -7;
    nums[6] = -5;
    nums[7] = -5;
    nums[8] = -1;
    nums[9] = 0;
    nums[10] = 0;
    nums[11] = 1;
    nums[12] = 3;
    nums[13] = 4;
    nums[14] = 5;
    nums[15] = 5;
    nums[16] = 8;
    nums[17] = 10;
    nums[18] = 11;
    nums[19] = 14;
  }


  func removeDuplicates() int {
    var x, y int;
    y = 0;
    for(x = 1; x < 20; x = x + 1){
        if(nums[x] != nums[y]){
            y = y + 1;
            nums[y] = nums[x];
        }
    }
    return(y + 1);
  }


 func printList(length int) void {
    var i int;
    for (i = 0; i < length; i = i + 1) {
      print_int(nums[i]);
      print_string(" ");
    }
    print_string("\n");
  }




  func main() int {
    createList();
    print_string("array before removing duplicates: ");
    printList(20);

    print_string("array after removing duplicates: ");
    printList(removeDuplicates());

    print_string("\n");
    return(0);
  }
}
