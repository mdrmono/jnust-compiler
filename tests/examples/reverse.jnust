extern func print_int(int) void;
extern func print_string(string) void;

package ReverseList {
  var nums [6]int;

  func initList() void {
    nums[0] = 1;
    nums[1] = 2;
    nums[2] = 3;
    nums[3] = 4;
    nums[4] = 5;
    nums[5] = 6;
  }

  func printList() void {
    var i int;
    for (i = 0; i < 6; i = i + 1) {
      print_int(nums[i]);
      print_string(" ");
    }
    print_string("\n");
  }

  func reverseList() void {
    var left, right, temp int;
    left = 0;
    right = 5;
    while (left < right) {
      temp = nums[left];
      nums[left] = nums[right];
      nums[right] = temp;
      left = left + 1;
      right = right - 1;
    }
  }

  func main() int {
    initList();
    printList();
    reverseList();
    printList();
    return (0);
  }
}